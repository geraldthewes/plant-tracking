    "/api/plants/": {
      "get": {
        "tags": [
          "plants"
        ],
        "summary": "List Plants",
        "description": "List all plants with optional alive/dead filtering.\n\nArgs:\n    alive_only: If True, return only plants without death_date.\n    dead_only: If True, return only plants with death_date.\n\nReturns:\n    PlantListResponse: List of matching plants and count.\n\nRaises:\n    HTTPException: 400 if both filters specified.",
        "operationId": "list_plants_api_plants__get",
        "parameters": [
          {
            "name": "alive_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Alive Only"
            }
          },
          {
            "name": "dead_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Dead Only"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
