@startuml
title Plant Tracking System - UI Screen Map

skinparam rectangle {
  BackgroundColor #f0f7ff
  BorderColor #3b82f6
  FontColor #1e293b
}
skinparam defaultFontColor #1e293b
skinparam arrowColor #475569
skinparam shadowing false

rectangle "Plant Tracking" as root
rectangle "Dashboard" as dash
rectangle "Plant Detail" as detail
rectangle "Add Plant" as add_plant
rectangle "Manage Varieties" as varieties
rectangle "Manage Seed Packets" as packets
rectangle "Manage Origins" as origins
rectangle "Label Studio" as label
rectangle "Activity Logger" as logger
rectangle "Compare View" as compare
rectangle "Scan Screen" as scan
rectangle "Settings" as settings

root --> dash
root --> detail
root --> add_plant
root --> varieties
root --> packets
root --> origins
root --> label
root --> logger
root --> compare
root --> scan
root --> settings

dash --> [Plant List]
dash --> [Quick Stats]
dash --> [Search / Filters]

detail --> [Overview Header]
detail --> [Care Timeline]
detail --> [Photo Gallery]
detail --> [Quick Actions]

add_plant --> [Select Variety]
add_plant --> [Select Seed Packet]
add_plant --> [Plant ID Preview]
add_plant --> [Label Preview]

varieties --> [Variety List]
varieties --> [Add New Variety]
varieties --> [Variety Detail]

packets --> [Packet List]
packets --> [Add New Seed Packet]
packets --> [Packet Detail]

origins --> [Origin List]
origins --> [Add New Origin]
origins --> [Origin Detail]

label --> [Template Selector]
label --> [Label Designer]
label --> [Print Queue]

logger --> [Watering Log]
logger --> [Fertilizer Log]
logger --> [Humidity Log]
logger --> [Note Entry]

compare --> [Side-by-Side]
compare --> [Growth Charts]
compare --> [Gap Analysis]

scan --> [QR Scanner]
scan --> [Camera Capture]

settings --> [Printer Config]
settings --> [Export / Import]
settings --> [Backup / Restore]
@enduml
