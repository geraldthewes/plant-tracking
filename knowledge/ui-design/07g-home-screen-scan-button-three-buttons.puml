@startuml
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam rectangle {
  borderRadius 0
  backgroundColor #f8fafc
  borderColor #e2e8f0
}

' Force portrait orientation by making content taller than wide
' Conceptual dimensions: width:height ratio of 2:3 (typical phone portrait)
title Home Screen - Portrait / Mobile (Scan Button + Three-Button Row)

rectangle "Screen" as screen {
  ' Set implicit aspect ratio to favor portrait (taller than wide)
  
  rectangle "Header" as header {
    rectangle "🌱 Plant Tracking" as app_title
    rectangle "⚙️ Settings" as settings_icon
  }

  rectangle "Main" as main {

    rectangle "Primary Interaction: SCAN BUTTON" as scanner_button {
      rectangle "📱 Scan Plant QR Code" as scan_button_label
      rectangle "Tap to activate camera and scan QR code" as scan_hint
      rectangle "Or enter ID manually" as manual_entry_hint
    }

    rectangle "Action Button Row" as button_row {
      rectangle "Button 1: Plant Care" as btn_plant_care {
        rectangle "🌿 Plant Care" as btn1_label
        rectangle "💧5" as btn1_badge
      }

      rectangle "Button 2: Activity Log" as btn_activity_log {
        rectangle "📓 Activity Log" as btn2_label
      }

      rectangle "Button 3: More Features" as btn_more {
        rectangle "☰ More" as btn3_label
      }
    }
  }

  ' Vertical flow: header -> main content
  header -[hidden]down-> main
  main -[hidden]down-> scanner_button
  scanner_button -[hidden]down-> button_row
}
@enduml
