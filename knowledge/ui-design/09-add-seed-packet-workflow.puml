@startuml
skinparam activity {
  BackgroundColor #F8F1E3
  BorderColor #6B4226
  FontColor #4A3728
}
skinparam condition {
  BackgroundColor #EDE5D8
  BorderColor #B04E2E
  FontColor #4A3728
}
skinparam start {
  BackgroundColor #4A6B2E
  BorderColor #3D5A24
  FontColor #FFFFFF
}
skinparam stop {
  BackgroundColor #A0342E
  BorderColor #8B2E28
  FontColor #FFFFFF
}
skinparam note {
  BackgroundColor #EDE5D8
  BorderColor #D4C8B8
  FontColor #6B4226
}
skinparam defaultFontColor #4A3728
skinparam arrowColor #6B4226
skinparam shadowing false

title Add Seed Packet Workflow

start

if (Entry point?) then ("Add Plant wizard Step 3")
  :From Add Plant flow;\nno packet exists for variety;
else ("Library → Seed Packets → +")
  :From Library management;
endif

partition "Photo Capture" {
  :Tap "Front of Packet" zone;
  if (Camera or Gallery?) then (Camera)
    :Open camera — photograph packet front;
  else (Gallery)
    :Pick existing photo from gallery;
  endif
  :Photo fills front zone;\n"Retake" / "✕" buttons available;
  
  :Tap "Back of Packet" zone;
  :Capture or select back photo;
}

partition "Brand & Origin" {
  :Enter brand name;\n(autocomplete from known brands);
  if (Brand not in list?) then (New brand)
    :Type new brand — auto-saved\nto brand library on blur;
  endif
  :Optional: select or add origin (supplier);
  :Optional: enter packed-for date;
  :Optional: enter seed count / weight;
}

partition "Variety Information" {
  :Enter variety name;
  :Enter Latin name (italicized preview);
  
  :Genus auto-extracted from Latin name;
  if (Genus exists in library?) then (Yes)
    :Genus pre-selected automatically;
  else (No)
    :Prompt: "Genus not found. Create it?";
    if (Create inline?) then (Yes)
      :Inline genus form slides down;
      :Enter common name, family;
      :Save genus — auto-selected;
    else (Cancel)
      :Manual genus selection required;
    endif
  endif
  
  :Optional: enter Scoville units (peppers);
  :Optional: toggle certifications;\n(Heirloom, Non-GMO, Organic, etc.);
}

partition "Planting Specifications" {
  :Enter days to maturity (e.g., "80–100");
  :Enter days to germination (e.g., "7–21");
  :Enter planting depth (e.g., "1/4\");
  :Enter plant spacing (e.g., "12\"–18\");
  :Select sun requirement;\n(Full Sun, Partial Sun, etc.);
  :Enter start indoors instructions;
}

partition "Notes" {
  :Optional: add special instructions\nfrom packet;
}

:Tap "Save Packet";

if (Entry point?) then ("Add Plant wizard")
  :Return to Step 3 of Add Plant;\nnew packet pre-selected;
else ("Library")
  :Toast: "Packet saved";
  :Return to Seed Packets list;
endif

stop
@enduml
