# Plant Tracking Application
# Copy this file to .env and edit with your credentials

# PostgreSQL database connection
DATABASE_URL=postgresql://user:password@localhost:5432/plant_tracking

# Local database directory (for Markdown backup/export)
PLANT_DATABASE_DIR=database

# S3 configuration for media attachments
S3_BUCKET=plant-tracking-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=  # Optional: for local testing with localstack
