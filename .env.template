# Plant Tracking Application — generic template
# Copy manually once, then fill in all <placeholder> values:
#   cp .env.template .env
#
# For laptop-local dev (Postgres + SeaweedFS via Docker):
#   cp .env.local.template .env.local && cp .env.local .env
#   docker compose up -d
#   alembic upgrade head
#
# For home cluster (Consul Postgres + Ceph RGW):
#   cp .env.cluster.template .env.cluster && cp .env.cluster .env

# PostgreSQL database connection
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Local database directory (for Markdown backup/export)
PLANT_DATABASE_DIR=database

# S3 configuration for media attachments
S3_BUCKET=<your-bucket-name>
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<your-access-key>
S3_SECRET_ACCESS_KEY=<your-secret-key>
# S3_ENDPOINT_URL=  # Custom endpoint (e.g. SeaweedFS http://127.0.0.1:8333 or Ceph RGW)
# S3_FORCE_PATH_STYLE=false  # Set true for SeaweedFS local dev
