# Local development template — copy manually once, then edit values:
#   cp .env.local.template .env.local
#   cp .env.local .env
# Requires: docker compose up -d
# S3 keys must match credentials in docker/seaweedfs-s3.json (create from .template)
# LOCAL_POSTGRES_* are used by docker compose for the Postgres container

LOCAL_POSTGRES_USER=<user>
LOCAL_POSTGRES_PASSWORD=<password>
LOCAL_POSTGRES_DB=<database>

# PostgreSQL (docker-compose postgres service on host port 5433)
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/<database>

# Markdown backup/export directory
PLANT_DATABASE_DIR=database

# SeaweedFS S3 gateway (docker-compose seaweedfs-s3 service)
S3_BUCKET=<your-bucket-name>
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<your-access-key>
S3_SECRET_ACCESS_KEY=<your-secret-key>
S3_ENDPOINT_URL=http://127.0.0.1:8333
S3_FORCE_PATH_STYLE=true