# Home cluster — copy to .env.cluster, then to .env
#   cp .env.cluster.template .env.cluster
#   cp .env.cluster .env
# Requires: gpucluster VPN up; cluster Postgres and Ceph RGW reachable

# PostgreSQL (Consul service discovery)
DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/<database>

# Markdown backup/export directory
PLANT_DATABASE_DIR=database

# Ceph RGW (S3-compatible object store)
S3_BUCKET=<your-bucket-name>
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=http://<s3-host>:<port>
# S3_FORCE_PATH_STYLE=false  # Leave unset for Ceph RGW