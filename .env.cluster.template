# Home cluster template — copy manually once, then edit values:
#   cp .env.cluster.template .env.cluster
#   cp .env.cluster .env
# Requires: cluster VPN/DNS; Postgres and S3 endpoints reachable

# PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@<postgres-host>:5432/<database>

# Markdown backup/export directory
PLANT_DATABASE_DIR=database

# S3-compatible object store (e.g. Ceph RGW)
S3_BUCKET=<your-bucket-name>
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=<your-access-key>
S3_SECRET_ACCESS_KEY=<your-secret-key>
S3_ENDPOINT_URL=http://<s3-host>:<port>
# S3_FORCE_PATH_STYLE=false  # Leave unset for Ceph RGW